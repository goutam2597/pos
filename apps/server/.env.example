# ---------------------------------------------------------------------------
# MonoPOS server configuration
# Copy to .env and fill in. The server validates this at boot and refuses to
# start if something required is missing — a misconfigured deployment should
# fail immediately, not on the first request that happens to touch it.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Origin of the web client. Used for CORS in production.
WEB_ORIGIN=http://localhost:5173

# Postgres connection string.
#
# The Docker Compose file publishes Postgres on 5434 because 5432 is already
# taken on this machine. Inside the compose network it would be
# postgresql://monopos:monopos@postgres:5432/monopos
DATABASE_URL="postgresql://monopos:monopos@localhost:5434/monopos?schema=public"

# ---------------------------------------------------------------------------
# Secrets — REQUIRED in production, at least 32 characters each.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------
JWT_SECRET=dev-only-insecure-jwt-secret-change-me-32chars
JWT_REFRESH_SECRET=dev-only-insecure-refresh-secret-change-me-32ch

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Cookie behaviour. Set COOKIE_SECURE=true behind HTTPS in production.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Only enable behind a reverse proxy you control, otherwise clients can spoof
# their IP and defeat rate limiting.
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Limits and tuning
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=8
LOCKOUT_MINUTES=15

SYNC_MAX_BATCH=100
SYNC_MAX_PULL_LIMIT=500

LOG_LEVEL=debug

{
  "name": "@monopos/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "verify": "tsx scripts/e2e-check.ts",
    "verify:pricing": "tsx scripts/pricing-parity.ts",
    "test": "vitest run",
    "contract:emit": "prisma contract emit"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@monopos/shared": "*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/cli-engine": "0.6.3",
    "@prisma/client": "7.10.0",
    "@prisma/orm-postgres": "8.0.0-rc.16",
    "@types/multer": "^2.3.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "multer": "^2.4.0",
    "pg": "^8.16.3",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@prisma/prisma7": "7.10.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.18.9",
    "@types/pg": "^8.15.6",
    "prisma": "8.0.0-rc.21",
    "tsx": "^4.20.6",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  }
}

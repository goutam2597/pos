{
  "name": "monopos",
  "version": "1.0.0",
  "private": true,
  "description": "Complete Point of Sale, Inventory, ERP, Online & Offline POS, Invoicing, Accounting and Business Management Platform",
  "workspaces": [
    "packages/shared",
    "apps/server",
    "apps/web"
  ],
  "scripts": {
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "setup": "npm install && npm install --prefix tools/prisma7 && npm run db:up && npm run db:push && npm run db:seed",
    "db:generate": "node tools/prisma7/run.mjs generate",
    "db:push": "node tools/prisma7/run.mjs db push",
    "db:migrate": "node tools/prisma7/run.mjs migrate dev",
    "db:studio": "node tools/prisma7/run.mjs studio",
    "db:seed": "npm run db:seed -w @monopos/server",
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev -w @monopos/server",
    "dev:web": "npm run dev -w @monopos/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test -w @monopos/server"
  },
  "devDependencies": {
    "bwip-js": "^4.11.4",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.11"
  },
  "overrides": {
    "@effect/platform-bun": "4.0.0-rc.115",
    "@effect/platform-node": "4.0.0-rc.115",
    "@effect/platform-node-shared": "4.0.0-rc.115",
    "@effect/sql-d1": "4.0.0-rc.115",
    "@effect/sql-mysql2": "4.0.0-rc.115",
    "@effect/sql-pg": "4.0.0-rc.115",
    "@effect/sql-sqlite-do": "4.0.0-rc.115",
    "@effect/vitest": "4.0.0-rc.115",
    "effect": "4.0.0-rc.115"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "esbuild@0.25.12": true,
    "workerd@1.20260901.1": true
  },
  "dependencies": {
    "@prisma/adapter-pg": "8.1.0-dev.7",
    "@prisma/client": "8.1.0-dev.7",
    "@prisma/composer": "0.28.0",
    "@prisma/composer-prisma-cloud": "0.28.0",
    "alchemy": "2.0.0-beta.78",
    "effect": "4.0.0-rc.115",
    "prisma": "8.0.0-rc.21"
  }
}
